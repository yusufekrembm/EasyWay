<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/customViewContainer"
    tools:context=".ui.main.youtube.YoutubeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/myToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D01F1F"
            app:title="Youtube"
            app:titleTextColor="@color/white"
            tools:ignore="MissingConstraints" />

        <androidx.cardview.widget.CardView
            android:id="@+id/searchYoutubeVideosCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/myToolbar">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view_youtube"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:defaultQueryHint="Search"
                app:iconifiedByDefault="false">

            </androidx.appcompat.widget.SearchView>
        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerYoutubeVideos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@+id/searchYoutubeVideosCardView"
            tools:layout_editor_absoluteX="14dp"
            tools:listitem="@layout/list_item_youtube_video" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

